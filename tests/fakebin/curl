#!/bin/sh
# Stand-in for curl so the test suite can drive the real scripts without
# touching the network. Serves canned JSON from $FAKE_ROOT based on the URL,
# and distinguishes callers by their Authorization header.
url=""
auth=""

while [ $# -gt 0 ]; do
    case "$1" in
        -H)
            shift
            case "${1:-}" in
                Authorization:*) auth=${1#*Bearer } ;;
            esac
            ;;
        http*) url=$1 ;;
    esac
    shift
done

# Anything that is not the GitHub API is an outbound notification. Record it and
# pretend it succeeded, so the notification layer is testable offline.
case "$url" in
    *api.github.com*) ;;
    *)
        if [ -n "${url:-}" ]; then
            [ -n "${FAKE_NOTIFY_LOG:-}" ] && printf '%s\n' "$url" >> "$FAKE_NOTIFY_LOG"
            printf '{}\n'
            exit 0
        fi
        ;;
esac

if [ "${FAKE_API_FAIL:-0}" = "1" ]; then
    echo "curl: (22) simulated API failure" >&2
    exit 22
fi

page_of() { printf '%s' "$url" | sed -n 's/.*[?&]page=\([0-9][0-9]*\).*/\1/p'; }

case "$url" in
    */user/repos*)
        page=$(page_of)
        if [ -n "$page" ] && [ "$page" -gt 1 ]; then
            printf '[]\n'
            exit 0
        fi
        f="$FAKE_ROOT/userrepos_${auth:-anon}.json"
        ;;
    */users/*/repos*)
        page=$(page_of)
        if [ -n "$page" ] && [ "$page" -gt 1 ]; then
            printf '[]\n'
            exit 0
        fi
        owner=$(printf '%s' "$url" | sed 's|.*/users/||; s|/repos.*||')
        f="$FAKE_ROOT/owner_$owner.json"
        ;;
    */orgs/*/repos*)
        owner=$(printf '%s' "$url" | sed 's|.*/orgs/||; s|/repos.*||')
        f="$FAKE_ROOT/org_$owner.json"
        ;;
    */repos/*/events*)
        repo=$(printf '%s' "$url" | sed 's|.*/repos/||; s|/events.*||; s|/|_|g')
        f="$FAKE_ROOT/events_$repo.json"
        ;;
    */user)
        f="$FAKE_ROOT/user_${auth:-anon}.json"
        ;;
    *)
        echo "fake curl: unexpected url: $url" >&2
        exit 22
        ;;
esac

if [ ! -r "$f" ]; then
    echo "curl: (22) 404 for $url" >&2
    exit 22
fi
cat "$f"
